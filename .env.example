# Public browser configuration (publishable key is safe to expose by design)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side equivalents used by server code when needed
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Canonical public site URL, e.g. https://your-preview-domain.example
VITE_SITE_URL=http://localhost:5173

# NEVER put service-role keys, payment secrets, SMTP/API secrets, or private keys
# in VITE_* variables or commit them to this repository.

# Server-only secrets: placeholders for later backend/Edge Function integration.
# Do not put these values in VITE_* variables, client-side code, GitHub issues,
# screenshots, or chat. These placeholders are not active integrations.
# For Supabase Edge Functions, set them with the Supabase secrets manager for
# the dedicated 2.0 project; do not copy production keys into this file.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=Zurify <no-reply@example.com>

# Flutterwave is the intended first provider, but live payments remain disabled
# until checkout, signature verification, idempotency and reconciliation pass.
PAYMENT_PROVIDER=disabled
FLUTTERWAVE_PUBLIC_KEY=REPLACE_WITH_FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_SECRET_KEY=REPLACE_WITH_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_ENCRYPTION_KEY=REPLACE_WITH_FLUTTERWAVE_ENCRYPTION_KEY
FLUTTERWAVE_WEBHOOK_HASH=REPLACE_WITH_FLUTTERWAVE_WEBHOOK_SECRET

# Future Paystack option; keep empty until a separate integration is implemented.
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
